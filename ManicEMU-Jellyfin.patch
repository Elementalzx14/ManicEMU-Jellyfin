+// SPDX-License-Identifier: AGPL-3.0-or-later
+import UIKit
+import Security
+
+private enum JellyfinAccountStore {
+    private static var key: [String: Any] {
+        [kSecClass as String: kSecClassGenericPassword,
+         kSecAttrService as String: (Bundle.main.bundleIdentifier ?? "ManicEMU") + ".jellyfin",
+         kSecAttrAccount as String: "current-account"]
+    }
+
+    static func load() -> JellyfinAccount? {
+        var query = key
+        query[kSecReturnData as String] = true
+        var result: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess,
+              let data = result as? Data else { return nil }
+        return try? JSONDecoder().decode(JellyfinAccount.self, from: data)
+    }
+
+    static func save(_ account: JellyfinAccount) throws {
+        let data = try JSONEncoder().encode(account)
+        var query = key
+        query[kSecValueData as String] = data
+        query[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        let status = SecItemAdd(query as CFDictionary, nil)
+        if status == errSecDuplicateItem {
+            guard SecItemUpdate(key as CFDictionary, [kSecValueData as String: data] as CFDictionary) == errSecSuccess else {
+                throw JellyfinError.message("Could not save your Jellyfin sign-in securely.")
+            }
+        } else if status != errSecSuccess {
+            throw JellyfinError.message("Could not save your Jellyfin sign-in securely.")
+        }
+    }
+
+    static func clear() throws {
+        let status = SecItemDelete(key as CFDictionary)
+        guard status == errSecSuccess || status == errSecItemNotFound else {
+            throw JellyfinError.message("Could not remove your saved sign-in. Please try again.")
+        }
+    }
+}
