diff --git a/Tests/Jellyfin/JellyfinClientTests.swift b/Tests/Jellyfin/JellyfinClientTests.swift
new file mode 100644
index 0000000..02a8f7a
--- /dev/null
+++ b/Tests/Jellyfin/JellyfinClientTests.swift
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import XCTest
+@testable import ManicJellyfin
+
+private final class StubProtocol: URLProtocol {
+    static var respond: ((URLRequest) throws -> (Int, String))?
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+    override func startLoading() {
+        do {
+            let (code, body) = try Self.respond!(request)
+            client?.urlProtocol(self, didReceive: HTTPURLResponse(url: request.url!, statusCode: code,
+                httpVersion: nil, headerFields: ["Content-Type": "application/json"])!, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: Data(body.utf8))
+            client?.urlProtocolDidFinishLoading(self)
+        } catch { client?.urlProtocol(self, didFailWithError: error) }
+    }
+    override func stopLoading() {}
+}
+
+final class JellyfinClientTests: XCTestCase {
+    private func client() -> JellyfinClient {
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [StubProtocol.self]
+        return JellyfinClient(account: .init(server: URL(string: "https://example.com/jellyfin/")!,
+            userID: "user", token: "secret", deviceID: "device"), session: URLSession(configuration: config))
+    }
+
+    override func tearDown() { StubProtocol.respond = nil; super.tearDown() }
+
+    func testServerValidation() throws {
+        XCTAssertEqual(try JellyfinClient.serverURL(" http://192.168.1.10:8096 ").port, 8096)
+        for invalid in ["media.example.com", "file:///etc/passwd", "https://u:p@example.com", "https://example.com?api_key=secret", "https://example.com/#/home"] {
+            XCTAssertThrowsError(try JellyfinClient.serverURL(invalid))
+        }
+    }
+
+    func testBasePathAndHeaderAuthentication() throws {
+        let request = try client().request(["Items", "abc", "Download"])
+        XCTAssertEqual(request.url?.path, "/jellyfin/Items/abc/Download")
+        XCTAssertNil(request.url?.query)
+        XCTAssertTrue(request.value(forHTTPHeaderField: "Authorization")!.contains("Token=\"secret\""))
+    }
+
+    func testQueryEncodingAndPagination() async throws {
+        StubProtocol.respond = { request in
+            let parts = URLComponents(url: request.url!, resolvingAgainstBaseURL: false)!
+            let query = Dictionary(uniqueKeysWithValues: parts.queryItems!.map { ($0.name, $0.value!) })
+            XCTAssertEqual(query["searchTerm"], "Mario & Luigi")
+            XCTAssertEqual(query["startIndex"], "100")
+            XCTAssertEqual(query["userId"], "user")
+            XCTAssertEqual(query["parentId"], "games")
+            XCTAssertEqual(query["filters"], "IsNotFolder")
+            XCTAssertEqual(query["recursive"], "true")
+            return (200, #"{"Items":[{"Id":"game","Name":"Mario","Path":"C:\\ROMs\\Mario.nds"}],"TotalRecordCount":101}"#)
+        }
+        let page = try await client().items(parentID: "games", start: 100, search: "Mario & Luigi")
+        XCTAssertEqual(page.TotalRecordCount, 101)
+        XCTAssertEqual(page.Items.first?.fileName, "Mario.nds")
+    }
+
+    func testBrowsePreservesFoldersAndScopesPagination() async throws {
+        StubProtocol.respond = { request in
+            let parts = URLComponents(url: request.url!, resolvingAgainstBaseURL: false)!
+            let query = Dictionary(uniqueKeysWithValues: parts.queryItems!.map { ($0.name, $0.value!) })
+            XCTAssertEqual(query["parentId"], "nes-folder")
+            XCTAssertEqual(query["startIndex"], "100")
+            XCTAssertEqual(query["recursive"], "false")
+            XCTAssertNil(query["filters"])
+            XCTAssertEqual(query["sortBy"], "IsFolder,SortName")
+            XCTAssertEqual(query["sortOrder"], "Descending,Ascending")
+            return (200, #"{"Items":[{"Id":"folder","Name":"NES","IsFolder":true},{"Id":"rom","Name":"Game","Path":"/roms/Game.nes","IsFolder":false}],"TotalRecordCount":102}"#)
+        }
+        let page = try await client().items(parentID: "nes-folder", start: 100, search: "  ")
+        XCTAssertEqual(page.Items.count, 2)
+        XCTAssertEqual(page.Items[0].IsFolder, true)
+        XCTAssertEqual(page.Items[1].fileName, "Game.nes")
+    }
+
+    func testMissingOptionalMetadata() throws {
+        let page = try JSONDecoder().decode(JellyfinPage.self, from: Data(#"{"Items":[{"Id":"1","Name":"Game"}]}"#.utf8))
+        XCTAssertEqual(page.Items[0].fileName, "")
+        XCTAssertNil(page.TotalRecordCount)
+    }
+
+    func testOlderLibraryEndpointFallback() async throws {
+        var paths: [String] = []
+        StubProtocol.respond = { request in
+            paths.append(request.url!.path)
+            if paths.count == 1 { return (404, "") }
+            return (200, #"{"Items":[{"Id":"games","Name":"Games","IsFolder":true}]}"#)
+        }
+        let libraries = try await client().libraries()
+        XCTAssertEqual(paths, ["/jellyfin/UserViews", "/jellyfin/Users/user/Views"])
+        XCTAssertEqual(libraries.first?.Name, "Games")
+    }
+
+    func testUnauthorizedDoesNotFallback() async {
+        var count = 0
+        StubProtocol.respond = { _ in count += 1; return (401, "") }
+        do { _ = try await client().libraries(); XCTFail("Expected authentication error") }
+        catch JellyfinError.http(401) { }
+        catch { XCTFail("Unexpected error: \(error)") }
+        XCTAssertEqual(count, 1)
+    }
+
+    func testForbiddenDownloadMessage() {
+        XCTAssertTrue(JellyfinError.http(403).localizedDescription.contains("permission"))
+    }
+
+    func testCrossOriginRedirectIsRejected() {
+        let session = URLSession(configuration: .ephemeral)
+        defer { session.invalidateAndCancel() }
+        let original = URL(string: "https://example.com/jellyfin/Items")!
+        let task = session.dataTask(with: original)
+        let response = HTTPURLResponse(url: original, statusCode: 302, httpVersion: nil, headerFields: nil)!
+        JellyfinRedirectGuard().urlSession(session, task: task, willPerformHTTPRedirection: response,
+            newRequest: URLRequest(url: URL(string: "https://other.example/collect")!)) { request in
+                XCTAssertNil(request)
+            }
+        task.cancel()
+    }
+}
