+    private func download(_ item: JellyfinItem, client: JellyfinClient) {
+        searchTask?.cancel()
+        downloading = true
+        isModalInPresentation = true
+        let progress = UIAlertController(title: "Downloading \(item.Name)", message: "Keep ManicEMU open. The game will be added to your local library when the download finishes.", preferredStyle: .alert)
+        progress.addAction(UIAlertAction(title: "Cancel", style: .cancel) { [weak self] _ in self?.operation?.cancel() })
+        present(progress, animated: true)
+        operation = Task {
+            do {
+                let url = try await client.download(item)
+                let directory = url.deletingLastPathComponent()
+                if Task.isCancelled {
+                    try? FileManager.default.removeItem(at: directory)
+                    throw CancellationError()
+                }
+                guard let type = FileType(fileExtension: url.pathExtension.lowercased()), type == .game || type == .zip else {
+                    try? FileManager.default.removeItem(at: directory)
+                    throw JellyfinError.message("This item is not a supported ROM or archive. Select a game file; multi-file games need an archive containing all their files.")
+                }
+                downloading = false
+                importing = true
+                progress.dismiss(animated: true) {
+                    FilesImporter.importFiles(urls: [url], importCompletion: { [weak self] in
+                        try? FileManager.default.removeItem(at: directory)
+                        self?.importing = false
+                        self?.isModalInPresentation = false
+                    })
+                }
+            } catch {
+                downloading = false
+                isModalInPresentation = false
+                if presentedViewController === progress {
+                    progress.dismiss(animated: true) { self.showError(error) }
+                } else { showError(error) }
+            }
+        }
+    }
+}
