index 0000000..f87bf5f
--- /dev/null
+++ b/ManicEmu/ManicEmu/Sources/Business/Import/Models/JellyfinClient.swift
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import Foundation
+
+struct JellyfinAccount: Codable {
+    let server: URL
+    let userID: String
+    let token: String
+    let deviceID: String
+}
+
+struct JellyfinItem: Decodable {
+    let Id: String
+    let Name: String
+    let Path: String?
+    let IsFolder: Bool?
+    let ImageTags: [String: String]?
+
+    var fileName: String {
+        (Path ?? "").replacingOccurrences(of: "\\", with: "/").components(separatedBy: "/").last ?? ""
+    }
+}
+
+struct JellyfinPage: Decodable {
+    let Items: [JellyfinItem]
+    let TotalRecordCount: Int?
+}
+
+enum JellyfinError: LocalizedError {
+    case message(String)
+    case http(Int)
+    var errorDescription: String? {
+        switch self {
+        case .message(let text): return text
+        case .http(401): return "Your Jellyfin sign-in expired or was rejected. Sign out and sign in again."
+        case .http(403): return "Your Jellyfin account does not have permission for this library or download."
+        case .http(404): return "Jellyfin could not find this item or endpoint. Check the server address and library."
+        case .http(let code): return "Jellyfin returned an error (HTTP \(code)). Please try again."
+        }
+    }
+}
+
+// Do not forward account credentials to a different origin, including via redirects.
+final class JellyfinRedirectGuard: NSObject, URLSessionTaskDelegate {
+    func urlSession(_ session: URLSession, task: URLSessionTask,
+                    willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest,
+                    completionHandler: @escaping (URLRequest?) -> Void) {
+        guard let original = task.originalRequest?.url, let target = request.url,
+              original.scheme == target.scheme, original.host == target.host,
+              original.port == target.port else {
+            completionHandler(nil)
+            return
+        }
+        completionHandler(request)
+    }
+}
+
+final class JellyfinClient {
+    let account: JellyfinAccount
+    private let session: URLSession
+
+    init(account: JellyfinAccount, session: URLSession? = nil) {
+        self.account = account
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 60
+        configuration.timeoutIntervalForResource = 60 * 60
+        self.session = session ?? URLSession(configuration: configuration,
+                                              delegate: JellyfinRedirectGuard(), delegateQueue: nil)
+    }
+
+    deinit { session.invalidateAndCancel() }
+
+    static func serverURL(_ address: String) throws -> URL {
+        guard let parts = URLComponents(string: address.trimmingCharacters(in: .whitespacesAndNewlines)),
+              let scheme = parts.scheme?.lowercased(), ["http", "https"].contains(scheme),
+              let host = parts.host, !host.isEmpty,
+              parts.user == nil, parts.password == nil, parts.query == nil, parts.fragment == nil,
+              let url = parts.url else {
+            throw JellyfinError.message("Enter your server's full address, such as https://media.example.com/jellyfin or http://192.168.1.10:8096.")
+        }
+        return url
+    }
+
+    func request(_ path: [String], query: [URLQueryItem] = [], method: String = "GET") throws -> URLRequest {
+        let url = path.reduce(account.server) { $0.appendingPathComponent($1) }
+        guard var components = URLComponents(url: url, resolvingAgainstBaseURL: false) else {
+            throw JellyfinError.message("Invalid Jellyfin server address.")
+        }
+        components.queryItems = query.isEmpty ? nil : query
+        guard let finalURL = components.url else { throw JellyfinError.message("Invalid Jellyfin request.") }
+        var request = URLRequest(url: finalURL)
+        request.httpMethod = method
+        // Header values returned by the server must never become extra auth parameters.
+        func escaped(_ value: String) -> String {
+            value.replacingOccurrences(of: "\\", with: "\\\\").replacingOccurrences(of: "\"", with: "\\\"")
+                .replacingOccurrences(of: "\r", with: "").replacingOccurrences(of: "\n", with: "")
+        }
+        var auth = "MediaBrowser Client=\"ManicEMU\", Device=\"ManicEMU\", DeviceId=\"\(escaped(account.deviceID))\", Version=\"1.0\""
+        if !account.token.isEmpty { auth += ", Token=\"\(escaped(account.token))\"" }
+        request.setValue(auth, forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        return request
+    }
+
+    private func validate(_ response: URLResponse) throws {
+        guard let http = response as? HTTPURLResponse else { throw JellyfinError.message("Invalid server response.") }
+        guard (200..<300).contains(http.statusCode) else { throw JellyfinError.http(http.statusCode) }
+    }
+
+    private func decode<T: Decodable>(_ request: URLRequest) async throws -> T {
+        let (data, response) = try await session.data(for: request)
+        try validate(response)
+        return try JSONDecoder().decode(T.self, from: data)
+    }
+
+    static func signIn(server: URL, username: String, password: String) async throws -> JellyfinAccount {
+        struct Authentication: Decodable {
+            struct UserInfo: Decodable { let Id: String }
+            let AccessToken: String
+            let User: UserInfo
+        }
+        let deviceID = UUID().uuidString
+        let client = JellyfinClient(account: .init(server: server, userID: "", token: "", deviceID: deviceID))
+        var request = try client.request(["Users", "AuthenticateByName"], method: "POST")
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.httpBody = try JSONSerialization.data(withJSONObject: ["Username": username, "Pw": password])
+        let result: Authentication = try await client.decode(request)
+        guard !result.AccessToken.isEmpty, !result.User.Id.isEmpty else {
+            throw JellyfinError.message("Jellyfin did not return a valid account session.")
+        }
+        return .init(server: server, userID: result.User.Id, token: result.AccessToken, deviceID: deviceID)
+    }
+
+    func libraries() async throws -> [JellyfinItem] {
+        let page: JellyfinPage
+        do {
+            page = try await decode(request(["UserViews"], query: [.init(name: "userId", value: account.userID)]))
+        } catch JellyfinError.http(404) {
+            // Older Jellyfin releases use the user ID in the path.
+            page = try await decode(request(["Users", account.userID, "Views"]))
+        }
+        return page.Items
+    }
+
+    func items(parentID: String, start: Int, search: String) async throws -> JellyfinPage {
+        let term = search.trimmingCharacters(in: .whitespacesAndNewlines)
+        let searching = !term.isEmpty
+        var query: [URLQueryItem] = [
+            .init(name: "userId", value: account.userID),
+            .init(name: "parentId", value: parentID),
+            .init(name: "recursive", value: searching ? "true" : "false"),
+            .init(name: "fields", value: "Path"),
+            .init(name: "sortBy", value: searching ? "SortName" : "IsFolder,SortName"),
+            .init(name: "sortOrder", value: searching ? "Ascending" : "Descending,Ascending"),
+            .init(name: "startIndex", value: String(start)),
+            .init(name: "limit", value: "100"),
+            .init(name: "enableTotalRecordCount", value: "true"),
+            .init(name: "searchTerm", value: term)
+        ]
+        if searching { query.append(.init(name: "filters", value: "IsNotFolder")) }
+        return try await decode(request(["Items"], query: query))
+    }
+
+    func cover(_ item: JellyfinItem) async throws -> Data {
+        let request = try request(["Items", item.Id, "Images", "Primary"], query: [
+            .init(name: "maxWidth", value: "160"), .init(name: "quality", value: "85"),
+            .init(name: "tag", value: item.ImageTags?["Primary"])
+        ])
+        let (data, response) = try await session.data(for: request)
+        try validate(response)
+        return data
+    }
+
+    func download(_ item: JellyfinItem) async throws -> URL {
+        let request = try request(["Items", item.Id, "Download"])
+        let (temporary, response) = try await session.download(for: request)
+        defer { try? FileManager.default.removeItem(at: temporary) }
+        try validate(response)
+        try Task.checkCancellation()
+        let mime = response.mimeType?.lowercased() ?? ""
+        guard !mime.contains("html"), !mime.contains("json") else {
+            throw JellyfinError.message("The server returned a page instead of a ROM file.")
+        }
+        let rawName = item.fileName.isEmpty ? (response.suggestedFilename ?? "") : item.fileName
+        let name = rawName.replacingOccurrences(of: "\\", with: "/").components(separatedBy: "/").last ?? ""
+        guard !name.isEmpty, name != ".", name != "..", !name.contains(":"), !name.contains("\0") else {
+            throw JellyfinError.message("Jellyfin did not provide a usable ROM filename.")
+        }
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("Jellyfin-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let destination = directory.appendingPathComponent(name)
+        do { try FileManager.default.moveItem(at: temporary, to: destination) }
+        catch { try? FileManager.default.removeItem(at: directory); throw error }
+        return destination
+    }
+
+    func signOut() async {
+        guard let request = try? request(["Sessions", "Logout"], method: "POST") else { return }
+        _ = try? await session.data(for: request)
+    }
+}
