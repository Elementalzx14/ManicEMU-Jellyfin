+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.swordfish.lemuroid.app.jellyfin;
+
+import android.net.Uri;
+import org.json.JSONObject;
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+final class JellyfinApi {
+    final String server, user, token, device;
+    volatile boolean cancelled;
+    private volatile HttpURLConnection active;
+
+    JellyfinApi(String server, String user, String token, String device) {
+        this.server = server; this.user = user; this.token = token; this.device = device;
+    }
+
+    static String validateServer(String value) throws Exception {
+        URI uri = new URI(value.trim());
+        if (!("https".equalsIgnoreCase(uri.getScheme()) || "http".equalsIgnoreCase(uri.getScheme())) ||
+            uri.getHost() == null || uri.getRawUserInfo() != null || uri.getRawQuery() != null || uri.getRawFragment() != null)
+            throw new IOException("Enter a full server address, such as https://media.example.com or http://192.168.1.10:8096.");
+        String result = uri.toASCIIString();
+        return result.endsWith("/") ? result : result + "/";
+    }
+
+    private static String header(String s) {
+        return s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\r", "").replace("\n", "");
+    }
+
+    Uri.Builder url(String path) { return Uri.parse(server + path).buildUpon(); }
+
+    HttpURLConnection connect(String url, String method) throws Exception {
+        if (cancelled) throw new InterruptedIOException("Cancelled");
+        URL target = new URL(url), origin = new URL(server);
+        if (!target.getProtocol().equalsIgnoreCase(origin.getProtocol()) || !target.getHost().equalsIgnoreCase(origin.getHost()) || target.getPort() != origin.getPort())
+            throw new IOException("The server request changed destination.");
+        HttpURLConnection c = (HttpURLConnection) target.openConnection();
+        active = c;
+        c.setInstanceFollowRedirects(false);
+        c.setConnectTimeout(20000); c.setReadTimeout(60000); c.setRequestMethod(method);
+        c.setRequestProperty("Authorization", "MediaBrowser Client=\"Jellyfin Games\", Device=\"Android\", DeviceId=\"" + header(device) + "\", Version=\"1.0\", Token=\"" + header(token) + "\"");
+        if (cancelled) { c.disconnect(); throw new InterruptedIOException("Cancelled"); }
+        return c;
+    }
+
+    static void check(HttpURLConnection c) throws Exception {
+        int code = c.getResponseCode();
+        if (code == 401) throw new IOException("Sign-in expired or was rejected. Sign out and sign in again.");
+        if (code == 403) throw new IOException("Your account does not have permission for this library or download.");
+        if (code < 200 || code >= 300) throw new HttpError(code);
+    }
+    static final class HttpError extends IOException {
+        final int code;
+        HttpError(int code) { super("Jellyfin returned HTTP " + code + ". Check your server address."); this.code = code; }
+    }
+
+    JSONObject json(String url, JSONObject body) throws Exception {
+        HttpURLConnection c = connect(url, body == null ? "GET" : "POST");
+        try {
+            if (body != null) {
+                c.setDoOutput(true); c.setRequestProperty("Content-Type", "application/json");
+                try (OutputStream out = c.getOutputStream()) { out.write(body.toString().getBytes(StandardCharsets.UTF_8)); }
+            }
+            check(c);
+            try (InputStream in = c.getInputStream(); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+                byte[] buffer = new byte[8192]; int n;
+                while ((n = in.read(buffer)) != -1) {
+                    if (cancelled) throw new InterruptedIOException("Cancelled");
+                    if (out.size() + n > 16 * 1024 * 1024) throw new IOException("Server response is too large.");
+                    out.write(buffer, 0, n);
+                }
+                return new JSONObject(out.toString("UTF-8"));
+            }
+        } finally { c.disconnect(); }
+    }
+
+    JSONObject libraries() throws Exception {
+        try { return json(url("UserViews").appendQueryParameter("userId", user).build().toString(), null); }
+        catch (HttpError e) {
+            if (e.code != 404) throw e;
+            return json(url("Users/" + Uri.encode(user) + "/Views").build().toString(), null);
+        }
+    }
+    JSONObject items(String parent, int start, String search) throws Exception {
+        boolean searching = !search.trim().isEmpty();
+        Uri.Builder b = url("Items").appendQueryParameter("userId", user).appendQueryParameter("parentId", parent)
+            .appendQueryParameter("recursive", searching ? "true" : "false")
+            .appendQueryParameter("fields", "Path").appendQueryParameter("sortBy", searching ? "SortName" : "IsFolder,SortName")
+            .appendQueryParameter("sortOrder", searching ? "Ascending" : "Descending,Ascending")
+            .appendQueryParameter("startIndex", String.valueOf(start)).appendQueryParameter("limit", "100")
+            .appendQueryParameter("enableTotalRecordCount", "true").appendQueryParameter("searchTerm", search.trim());
+        if (searching) b.appendQueryParameter("filters", "IsNotFolder");
+        return json(b.build().toString(), null);
+    }
+    static String filename(JSONObject item) {
+        String path = item.optString("Path", "").replace('\\', '/');
+        return path.substring(path.lastIndexOf('/') + 1);
+    }
+    static boolean supported(String name) {
+        int dot = name.lastIndexOf('.');
+        if (dot < 0) return false;
+        String ext = name.substring(dot + 1).toLowerCase(Locale.ROOT);
+        return ("|nes|fds|sfc|smc|gb|gbc|gba|nds|3ds|cci|cxi|z64|v64|n64|md|gen|smd|sms|gg|bin|cue|iso|cso|chd|pbp|m3u|pce|sgx|ngp|ngc|ws|wsc|a26|a78|lnx|zip|dosz|").contains("|" + ext + "|");
+    }
+    void download(JSONObject item, File root) throws Exception {
+        HttpURLConnection c = connect(url("Items/" + Uri.encode(item.getString("Id")) + "/Download").build().toString(), "GET");
+        File temporary = null;
+        try {
+            check(c);
+            String type = c.getContentType();
+            if (type != null && (type.toLowerCase(Locale.ROOT).contains("html") || type.toLowerCase(Locale.ROOT).contains("json")))
+                throw new IOException("The server returned a page instead of a game.");
+            String name = filename(item);
+            if (name.isEmpty()) {
+                String disposition = c.getHeaderField("Content-Disposition");
+                if (disposition != null) {
+                    java.util.regex.Matcher m = java.util.regex.Pattern.compile("filename=\"?([^\";]+)").matcher(disposition);
+                    if (m.find()) name = m.group(1).trim();
+                }
+            }
+            if (name.contains("/") || name.contains("\\") || name.contains(":") || name.indexOf(0) >= 0 || !supported(name))
+                throw new IOException("This item is not a supported game file or ZIP archive.");
+            String ext = name.substring(name.lastIndexOf('.') + 1).toLowerCase(Locale.ROOT);
+            if (ext.equals("cue") || ext.equals("m3u")) throw new IOException("This file needs companion files. Use a complete supported ZIP archive or a single-file CHD instead.");
+            if (!root.isDirectory() && !root.mkdirs()) throw new IOException("Could not create the games folder.");
+            temporary = new File(root, ".download-part");
+            long expected = c.getContentLengthLong(), total = 0;
+            try (InputStream in = c.getInputStream(); FileOutputStream out = new FileOutputStream(temporary)) {
+                byte[] buffer = new byte[65536]; int n;
+                while ((n = in.read(buffer)) != -1) {
+                    if (cancelled) throw new InterruptedIOException("Cancelled");
+                    out.write(buffer, 0, n); total += n;
+                }
+                out.getFD().sync();
+            }
+            if (cancelled) throw new InterruptedIOException("Cancelled");
+            if (total == 0 || (expected >= 0 && expected != total)) throw new IOException("The download was incomplete. Please try again.");
+            File target = new File(root, name);
+            if (target.exists()) throw new IOException("This game is already downloaded. Open Downloaded games to play it.");
+            if (!temporary.renameTo(target)) throw new IOException("Could not save the downloaded game.");
+        } finally { c.disconnect(); if (temporary != null) temporary.delete(); }
+    }
+    void cancel() { cancelled = true; HttpURLConnection c = active; if (c != null) c.disconnect(); }
+}
