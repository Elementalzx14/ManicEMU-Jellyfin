+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.swordfish.lemuroid.app.jellyfin;
+import org.junit.Test;
+import org.json.JSONObject;
+import static org.junit.Assert.*;
+public class JellyfinApiTest {
+ @Test public void serverPreservesBasePath() throws Exception {
+  assertEquals("https://example.com/jellyfin/",JellyfinApi.validateServer(" https://example.com/jellyfin "));
+  assertEquals("http://192.168.1.10:8096/",JellyfinApi.validateServer("http://192.168.1.10:8096"));
+ }
+ @Test public void rejectsUnsafeServerAddresses() throws Exception {
+  for(String value:new String[]{"example.com","file:///tmp/game","https://user:pass@example.com","https://example.com?token=secret","https://example.com/#/home"}) {
+   try {JellyfinApi.validateServer(value);fail(value);}catch(java.io.IOException|java.net.URISyntaxException expected){}
+  }
+ }
+ @Test public void filenamesHandleWindowsAndMissingPaths() throws Exception {
+  assertEquals("Mario.nes",JellyfinApi.filename(new JSONObject().put("Path","C:\\NES\\Mario.nes")));
+  assertEquals("",JellyfinApi.filename(new JSONObject()));
+ }
+ @Test public void recognisesGamesAndRejectsWebPages() {
+  assertTrue(JellyfinApi.supported("Game.NES"));assertTrue(JellyfinApi.supported("Game.sfc"));
+  assertTrue(JellyfinApi.supported("Game.chd"));assertFalse(JellyfinApi.supported("error.html"));assertFalse(JellyfinApi.supported("folder"));
+ }
+}
